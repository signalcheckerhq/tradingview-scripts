//@version=6
indicator("Edge vs Random: Does Your Entry Signal Beat Random Entries?", shorttitle = "Edge vs Random", overlay = true, max_bars_back = 5000)

// ─── Inputs ──────────────────────────────────────────────────────────────────
ruleIn  = input.string("RSI crosses back over a level", "Entry rule",
     options = ["RSI crosses back over a level", "Moving average crossover", "Breakout of the last N bars", "External signal (another indicator)"], group = "Signal",
     tooltip = "The rule that opens a trade. Long: RSI crosses back above the lower level, fast MA crosses above slow MA, close breaks above the highest high of the last N bars. Short: the mirror image (upper level, cross below, breaks below the lowest low).")
dirIn   = input.string("Long", "Direction", options = ["Long", "Short"], group = "Signal")
rsiLen  = input.int(14, "RSI length", minval = 2, group = "RSI rule")
rsiLo   = input.float(30, "RSI lower level (long)", minval = 1, maxval = 99, group = "RSI rule")
rsiHi   = input.float(70, "RSI upper level (short)", minval = 1, maxval = 99, group = "RSI rule")
maType  = input.string("EMA", "MA type", options = ["EMA", "SMA"], group = "Moving average rule")
maFast  = input.int(9, "Fast MA length", minval = 1, group = "Moving average rule")
maSlow  = input.int(21, "Slow MA length", minval = 2, group = "Moving average rule")
brkLen  = input.int(20, "Breakout lookback (bars)", minval = 2, group = "Breakout rule",
     tooltip = "Long: close above the highest high of the previous N bars. Short: close below the lowest low of the previous N bars.")
extSrc  = input.source(close, "External signal source", group = "External signal",
     tooltip = "Pick a plot from another indicator on this chart. A signal fires on the bar where this value crosses above the threshold (for example a plot that is 1 on signal bars and 0 otherwise, threshold 0.5).")
extThr  = input.float(0.5, "External threshold", group = "External signal")
holdN   = input.int(10, "Hold each trade for N bars", minval = 1, maxval = 500, group = "Trade",
     tooltip = "Every trade (signal or random) enters at the next bar's open and exits at the close N bars later. Same holding time for both, so only the timing differs.")
feePct  = input.float(0.1, "Fee per side %", minval = 0.0, maxval = 2.0, step = 0.01, group = "Trade",
     tooltip = "Charged on entry and exit. 0.1% is a common spot taker fee. Add your spread or slippage here too.")
testN   = input.int(3000, "Bars to test", minval = 200, maxval = 4800, group = "History",
     tooltip = "How many past signal bars are checked. Only bars whose whole trade is already closed are used.")
setsK   = input.int(500, "Random sets", minval = 100, maxval = 2000, step = 100, group = "History",
     tooltip = "How many random sets to draw. Each set has as many entries as the signal had, at random bars inside the same window.")
seedIn  = input.int(7, "Random seed", minval = 1, maxval = 2147483646, group = "History",
     tooltip = "Same seed = same random sets, so the numbers are repeatable. Change it to see how much the random baseline moves.")
showSig = input.bool(true, "Mark signal bars", group = "Display")
posIn   = input.string("Bottom right", "Table position", options = ["Bottom right", "Bottom left", "Top right", "Top left"], group = "Display")

isLong = dirIn == "Long"
fee    = feePct / 100.0
tPos   = switch posIn
    "Top right"   => position.top_right
    "Bottom left" => position.bottom_left
    "Top left"    => position.top_left
    => position.bottom_right

// ─── Signal (decided on the bar's close) ────────────────────────────────────
r      = ta.rsi(close, rsiLen)
fastMa = maType == "EMA" ? ta.ema(close, maFast) : ta.sma(close, maFast)
slowMa = maType == "EMA" ? ta.ema(close, maSlow) : ta.sma(close, maSlow)
hiPrev = ta.highest(high, brkLen)[1]
loPrev = ta.lowest(low, brkLen)[1]

bool sig = switch ruleIn
    "RSI crosses back over a level" => isLong ? ta.crossover(r, rsiLo) : ta.crossunder(r, rsiHi)
    "Moving average crossover"      => isLong ? ta.crossover(fastMa, slowMa) : ta.crossunder(fastMa, slowMa)
    "Breakout of the last N bars"   => isLong ? close > hiPrev : close < loPrev
    => ta.crossover(extSrc, extThr)

plotshape(showSig and sig and barstate.isconfirmed, "Signal", isLong ? shape.triangleup : shape.triangledown,
     isLong ? location.belowbar : location.abovebar, color.new(#2962ff, 0), size = size.tiny)
alertcondition(sig and barstate.isconfirmed, "Signal", "Edge vs Random: entry signal on {{ticker}} {{interval}} at {{close}}")

// ─── Helpers ─────────────────────────────────────────────────────────────────
pct(float x, int d) =>
    (x >= 0 ? "+" : "") + str.tostring(x * 100.0, d == 1 ? "#0.0" : d == 2 ? "#0.00" : "#0.000") + "%"

// Trade return after fees: enter at open of the bar after the signal, exit at close N bars later.
tradeRet(float ep, float xp) =>
    gross = isLong ? (xp - ep) / ep : (ep - xp) / ep
    gross - fee * (ep + xp) / ep

var table t = table.new(tPos, 2, 16, bgcolor = color.new(color.black, 10), border_color = color.new(#434651, 0), border_width = 1, frame_color = color.new(#434651, 0), frame_width = 1)

cell(int c, int row, string txt, color tc = #d1d4dc) =>
    table.cell(t, c, row, txt, text_color = tc, text_size = size.small, bgcolor = color.new(color.black, 10), text_halign = c == 0 ? text.align_left : text.align_right)

// ─── Calculation on the last bar only (closed trades only, no repainting) ──
if barstate.islast
    table.clear(t, 0, 0, 1, 15)
    off   = barstate.isconfirmed ? 0 : 1          // the live bar is never used
    first = off + holdN                           // newest signal bar whose trade has closed
    avail = bar_index - first - math.max(rsiLen, maSlow, brkLen) - 1
    m     = math.min(testN, avail)
    if m < 100
        cell(0, 0, "Edge vs Random")
        cell(1, 0, "not enough bars")
        cell(0, 1, "Needs about " + str.tostring(holdN + 150) + " closed bars.")
    else
        rets  = array.new_float(m)
        sigR  = array.new_float(0)
        for i = 0 to m - 1
            e  = first + i                        // signal bar offset
            rr = tradeRet(open[e - 1], close[e - holdN])
            array.set(rets, i, rr)
            if sig[e]
                array.push(sigR, rr)
        n = array.size(sigR)
        if n < 5
            cell(0, 0, "Edge vs Random")
            cell(1, 0, str.tostring(n) + " signals")
            cell(0, 1, "Fewer than 5 signals in " + str.tostring(m) + " bars. Test more bars or change the rule.")
            table.merge_cells(t, 0, 1, 1, 1)
        else
            avgSig = array.avg(sigR)
            wins   = 0
            for x in sigR
                if x > 0
                    wins += 1
            allAvg = array.avg(rets)
            rng = seedIn * 1.0                    // Park–Miller random numbers: exact in floating point, repeatable for the same seed
            avgs = array.new_float(setsK)
            beat = 0
            for k = 0 to setsK - 1
                s = 0.0
                for j = 1 to n
                    rng := (16807.0 * rng) % 2147483647.0
                    idx = math.min(m - 1, int(math.floor(rng / 2147483647.0 * m)))
                    s += array.get(rets, idx)
                a = s / n
                array.set(avgs, k, a)
                if a < avgSig
                    beat += 1
            share = beat * 1.0 / setsK
            p05 = array.percentile_nearest_rank(avgs, 5)
            p50 = array.percentile_nearest_rank(avgs, 50)
            p95 = array.percentile_nearest_rank(avgs, 95)
            hodl = isLong ? close[off] / open[first + m - 2] - 1 : open[first + m - 2] / close[off] - 1

            verdict = share >= 0.95 ? "Beat 95%+ of random sets" : share >= 0.80 ? "Better than most random sets, could still be luck" : share > 0.20 ? "No better than random entries" : "Worse than random entries"
            vcol    = share >= 0.95 ? color.new(#089981, 0) : share >= 0.80 ? color.new(#ff9800, 0) : share > 0.20 ? color.new(#d1d4dc, 0) : color.new(#f23645, 0)

            row = 0
            cell(0, row, "Edge vs Random", #ffffff)
            cell(1, row, dirIn + ", hold " + str.tostring(holdN) + " bars", #ffffff)
            row += 1
            cell(0, row, "Bars tested / signals")
            cell(1, row, str.tostring(m) + " / " + str.tostring(n))
            row += 1
            cell(0, row, "Signal: average trade after fees")
            cell(1, row, pct(avgSig, 2), avgSig >= 0 ? color.new(#089981, 0) : color.new(#f23645, 0))
            row += 1
            cell(0, row, "Signal: trades in profit")
            cell(1, row, str.tostring(wins * 100.0 / n, "#0") + "%  (" + str.tostring(wins) + " of " + str.tostring(n) + ")")
            row += 1
            cell(0, row, "Random sets: typical average trade")
            cell(1, row, pct(p50, 2))
            row += 1
            cell(0, row, "Random sets: middle 90%")
            cell(1, row, pct(p05, 2) + " to " + pct(p95, 2))
            row += 1
            cell(0, row, "Every bar as an entry (same hold)")
            cell(1, row, pct(allAvg, 2))
            row += 1
            cell(0, row, "Signal beat this share of random sets")
            cell(1, row, str.tostring(share * 100.0, "#0") + "%", vcol)
            row += 1
            cell(0, row, verdict, vcol)
            table.merge_cells(t, 0, row, 1, row)
            row += 1
            cell(0, row, "Buy and hold over the same window: " + pct(hodl, 1), #9598a1)
            table.merge_cells(t, 0, row, 1, row)
            row += 1
            cell(0, row, str.tostring(setsK) + " random sets of " + str.tostring(n) + " entries, seed " + str.tostring(seedIn) + ". Fee " + str.tostring(feePct, "#0.0##") + "% per side.", #787b86)
            table.merge_cells(t, 0, row, 1, row)
            row += 1
            cell(0, row, "Closed bars only. Past prices, not a forecast. Not financial advice.", #787b86)
            table.merge_cells(t, 0, row, 1, row)
